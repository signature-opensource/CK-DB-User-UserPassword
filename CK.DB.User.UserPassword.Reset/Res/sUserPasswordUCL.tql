-- SetupConfig: {}
--
-- @IsTemporary is tri-state:
--   null  - do not touch the current state. This is the default so that any caller that
--           ignores this extension (including the login paths of UserPasswordTable that
--           call this procedure in CreateOrUpdate mode when the hash must be rehashed)
--           leaves the flag untouched.
--   0 / 1 - explicitly sets the state.
--
-- The injections target the PostCreate and PostUpdate markers, that are both located
-- inside their respective "if" block: the flag is written only when the row has actually
-- been inserted or updated.
--
create transformer on CK.sUserPasswordUCL
as
begin
	add parameter @IsTemporary bit = null;

	inject "
		if @IsTemporary is not null
			update CK.tUserPassword set IsTemporary = @IsTemporary where UserId = @UserId;
	"
	into "PostCreate";

	inject "
		if @IsTemporary is not null
			update CK.tUserPassword set IsTemporary = @IsTemporary where UserId = @UserId;
	"
	into "PostUpdate";
end
